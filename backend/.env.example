# Copy to .env — never commit the real file (docs/06 §4 rule 11).
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-only-insecure-key-change-me-in-production-0123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://rorschach:rorschach@localhost:5432/rorschach
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=14
REFRESH_COOKIE_NAME=rorschach_refresh
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_DOMAIN=

# CORS / CSRF (Angular dev server)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Object storage (empty = local filesystem in development)
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
